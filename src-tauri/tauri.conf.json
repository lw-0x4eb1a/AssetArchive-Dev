{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible"
  },
  "productName": "Asset Archive",
  "mainBinaryName": "Asset Archive",
  "version": "0.1.8",
  "identifier": "com.dont-starve-asset-archive.dev",
  "plugins": {
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Asset Archive",
        "width": 960,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "decorations": true,
        "hiddenTitle": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}